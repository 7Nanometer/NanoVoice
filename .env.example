# ============================================================
#  环境配置模板
# ============================================================
#  用法：把本文件复制一份、改名为 .env，然后填上你自己的密钥。
#  .env 里存的是私密信息，绝对不要提交到 git、不要发给别人。
#  （本项目的 .gitignore 已经把 .env 排除掉了）
#
#  复制命令（在项目目录下执行）：
#      copy .env.example .env
# ============================================================


# ---------- 必填：文案生成用的 AI 接口 ----------
# 这是 DeepSeek 的密钥，去 https://platform.deepseek.com 注册后可以创建。
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=在这里填你的密钥

# 接口地址。用 DeepSeek 就保持下面这行不变。
OPENAI_BASE_URL=https://api.deepseek.com/v1


# ---------- 可选：下面这些不填也能跑，填了才生效 ----------

# 用哪个文案模型（默认 deepseek-chat）
#LLM_MODEL=deepseek-chat

# 语音引擎位置。搬家后项目自带 GPT-SoVITS\ 目录，这一行可以不管。
# 只有在"语音引擎放在别处"时才需要填。
#GPT_SOVITS_DIR=G:\GPT-SoVITS-v2pro-20250604

# 想换回出厂底模做对比时，把下面两行取消注释即可（答辩对比演示用）
#SOVITS_WEIGHT=G:\GPT-SoVITS-v2pro-20250604\GPT_SoVITS\pretrained_models\v2Pro\s2Gv2Pro.pth
#GPT_WEIGHT=G:\GPT-SoVITS-v2pro-20250604\GPT_SoVITS\pretrained_models\s1v3.ckpt

# 切换训练轮次做 A/B 对比（论文里的"模型选择"章节可以用）
#   SoVITS 可选：7Nanometer_e4_s136.pth / 7Nanometer_e8_s272.pth
#   GPT    可选：7Nanometer-e5.ckpt / 7Nanometer-e10.ckpt / 7Nanometer-e15.ckpt
#SOVITS_WEIGHT=GPT-SoVITS\SoVITS_weights_v2Pro\7Nanometer_e4_s136.pth
#GPT_WEIGHT=GPT-SoVITS\GPT_weights_v2Pro\7Nanometer-e10.ckpt

# 网页界面：
#   默认只允许本机打开（最安全）。
#   需要让手机/别的电脑访问时，改成 0.0.0.0 并**务必**同时设置用户名密码，
#   否则同一个网络下任何人都能操作你的系统、下载你的文件。
#APP_HOST=127.0.0.1
#APP_PORT=7860
#APP_USER=admin
#APP_PASS=换一个只有你知道的密码

# 导出 mp3 的码率（人声 96k 足够；调大只会让文件变大，音质提升听不出来）
#MP3_BITRATE=96k
